<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="workdone.Admin.AdminMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="AdminTitle" runat="server">Admin Portal - WorkDone</asp:ContentPlaceHolder></title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Google Fonts (Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    
    <!-- Custom Admin CSS -->
    <link href="../AdminContent/css/admin.css" rel="stylesheet" />
    
    <asp:ContentPlaceHolder ID="AdminHead" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="adminForm" runat="server">
        <div id="admin-wrapper">
            <!-- Sidebar Overlay for Mobile -->
            <div id="sidebarOverlay" class="sidebar-overlay"></div>

            <!-- SIDEBAR -->
            <aside id="admin-sidebar">
                <div class="sidebar-header">
                    <a href="AdminUsers.aspx" class="sidebar-brand">
                        <i class="bi bi-tools text-primary me-2"></i>WorkDone<span class="ms-1 text-primary">.Admin</span>
                    </a>
                </div>

                <div class="sidebar-menu">
                    <div class="sidebar-heading">Main Navigation</div>
                    
                    <div class="nav-admin-item">
                        <a href="AdminUsers.aspx" class="nav-admin-link <%= Request.Url.AbsolutePath.ToLower().Contains("adminusers.aspx") ? "active" : "" %>">
                            <i class="bi bi-people-fill"></i>
                            <span>Customers</span>
                        </a>
                    </div>

                    <div class="nav-admin-item">
                        <a href="AdminWorkers.aspx" class="nav-admin-link <%= Request.Url.AbsolutePath.ToLower().Contains("adminworkers.aspx") ? "active" : "" %>">
                            <i class="bi bi-person-badge-fill"></i>
                            <span>Professionals</span>
                        </a>
                    </div>

                    <div class="sidebar-heading">Quick Links</div>

                    <div class="nav-admin-item">
                        <a href="../Default.aspx" class="nav-admin-link text-white-50 border border-secondary border-opacity-25" target="_blank">
                            <i class="bi bi-box-arrow-up-right text-info"></i>
                            <span>Visit Public Site</span>
                        </a>
                    </div>
                </div>

                <div class="sidebar-footer">
                    <div class="admin-user-card">
                        <div class="admin-avatar-small">
                            AD
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-bold text-white small text-truncate">Administrator</div>
                            <div class="text-white-50" style="font-size: 0.75rem;">admin@workdone.com</div>
                        </div>
                        <a href="AdminLogin.aspx" class="text-white-50 hover-white p-1" title="Log Out">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </a>
                    </div>
                </div>
            </aside>

            <!-- PAGE CONTENT WRAPPER -->
            <div id="admin-content">
                <!-- TOPBAR -->
                <header class="admin-topbar">
                    <button type="button" id="sidebarToggle" class="btn btn-light rounded-circle p-2 me-3 border-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                        <i class="bi bi-list fs-5"></i>
                    </button>

                    <div class="topbar-search d-none d-md-block">
                        <i class="bi bi-search"></i>
                        <input type="text" class="form-control" placeholder="Search orders, workers, users..." />
                    </div>

                    <div class="ms-auto d-flex align-items-center gap-3">
                        <!-- User Profile Dropdown -->
                        <div class="dropdown">
                            <button type="button" class="btn p-0 border-0 d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="admin-avatar-small">AD</div>
                                <div class="text-start d-none d-sm-block">
                                    <div class="fw-bold small text-dark lh-1">Administrator</div>
                                    <span class="text-muted" style="font-size: 0.7rem;">Control Panel</span>
                                </div>
                                <i class="bi bi-chevron-down text-muted small ms-1"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg p-2 rounded-3" style="width: 220px;">
                                <li class="px-3 py-2 border-bottom mb-2">
                                    <div class="fw-bold text-dark">Admin User</div>
                                    <div class="text-muted small">admin@workdone.com</div>
                                </li>
                                <li><a class="dropdown-item rounded-2 py-2" href="AdminUsers.aspx"><i class="bi bi-people me-2 text-primary"></i>Customers</a></li>
                                <li><a class="dropdown-item rounded-2 py-2" href="AdminWorkers.aspx"><i class="bi bi-person-badge me-2 text-primary"></i>Professionals</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item rounded-2 py-2 text-danger" href="AdminLogin.aspx"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- MAIN PAGE CONTENT BODY -->
                <main class="p-3 p-md-4 flex-grow-1">
                    <asp:ContentPlaceHolder ID="AdminMainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>

                <!-- ADMIN FOOTER -->
                <footer class="bg-white border-top py-3 px-4 text-center text-muted small mt-auto">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center">
                        <div>&copy; <%: DateTime.Now.Year %> <strong>WorkDone.com</strong> - Admin Control Panel</div>
                        <div class="text-muted mt-1 mt-sm-0">Version 2.4.0 (Enterprise)</div>
                    </div>
                </footer>
            </div>
        </div>
    </form>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Chart.js for Admin Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Custom Admin JS -->
    <script src="../AdminContent/js/admin.js"></script>
    
    <asp:ContentPlaceHolder ID="AdminScripts" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
